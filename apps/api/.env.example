PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/openweb
# Optional alternative (safer for special characters in password):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=openweb
# POSTGRES_USER=user
# POSTGRES_PASSWORD=password
JWT_SECRET=change_me

# Web SSR server — the API posts here to purge the rendered-HTML cache when
# content changes. Defaults to the Docker service URL; for local dev point it
# at the web dev server, e.g. http://localhost:5173/__purge
# WEB_PURGE_URL=http://web:80/__purge

# SSO (optional)
# Google OAuth
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=

# Microsoft Entra ID (Azure AD)
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_MICROSOFT_TENANT_ID=common

# Custom OIDC IdP (Okta, Auth0, Keycloak, etc.)
SSO_OIDC_LABEL=SSO
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
SSO_OIDC_AUTH_URL=
SSO_OIDC_TOKEN_URL=
SSO_OIDC_USERINFO_URL=
SSO_OIDC_SCOPES=openid profile email

# Redis cache (optional)
# REDIS_COMMAND can be either a binary or a shell command:
# Example local binary: REDIS_COMMAND=redis-cli
# Example dockerized Redis: REDIS_COMMAND=docker exec openweb-redis redis-cli
REDIS_COMMAND=redis-cli
REDIS_URL=redis://redis:6379/0
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
